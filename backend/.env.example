# GCP Vertex AI 設定
VERTEX_PROJECT=tsmccareerhack2026-icsple-grp3

# Embedding model Settings
VERTEX_EMBEDDING_LOCATION=us-central1
EMBEDDING_MODEL=gemini-embedding-001

# Agent model Settings
VERTEX_AGENT_LOCATION=global
AGENT_MODEL=gemini-3-pro-preview

# GCP 認證
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json

# Google Search
GOOGLE_SEARCH_CREDENTIALS=google-search-SA.json # Using for Google Search API
GOOGLE_SEARCH_CX=e69550e3f99ce4c4c

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_WEBHOOK_URL=
DISCORD_BOT_ID=
DISCORD_BOT_NAME=
DISCORD_CHANNEL_ID=

# Application Settings
PORT=8000
DEBUG=True

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@db:5432/app

N8N_CALENDAR_WEBHOOK_URL=https://your-n8n-instance.com/webhook/...
